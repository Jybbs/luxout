{
  "name": "homebridge-luxout",
  "displayName": "Luxout",
  "type": "module",
  "version": "0.1.1",
  "description": "A Homebridge light sensor that tells Apple Home how bright it is outside, from the sun's position and Open-Meteo's forecast of sunlight.",
  "author": "Jybbs",
  "license": "MIT",
  "homepage": "https://luxout.fyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jybbs/luxout.git"
  },
  "bugs": {
    "url": "https://github.com/Jybbs/luxout/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "typescript",
    "nodejs",
    "homebridge",
    "homekit",
    "home-automation",
    "smart-home",
    "weather",
    "open-meteo",
    "light-sensor"
  ],
  "main": "dist/index.js",
  "files": [
    "dist/",
    "config.schema.json"
  ],
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || ^26.13.1",
    "homebridge": "^1.8.5 || ^2.0.0"
  },
  "dependencies": {
    "@badrap/valita": "0.5.5",
    "@homebridge/plugin-ui-utils": "2.3.0",
    "astronomy-engine": "2.1.19",
    "croner": "11.0.1"
  },
  "devDependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@fast-check/vitest": "0.5.0",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@homebridge/hap-client": "5.4.0",
    "@homebridge/hap-nodejs": "2.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/node": "4.3.5",
    "@tailwindcss/oxide": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.12",
    "@types/culori": "4.0.1",
    "@types/d3-array": "3.2.2",
    "@types/d3-polygon": "3.0.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "22.20.5",
    "@types/picomatch": "4.0.3",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vueuse/core": "15.0.0",
    "@zag-js/accordion": "1.48.0",
    "@zag-js/collapsible": "1.48.0",
    "@zag-js/listbox": "1.48.0",
    "@zag-js/live-region": "1.48.0",
    "@zag-js/radio-group": "1.48.0",
    "@zag-js/slider": "1.48.0",
    "@zag-js/tabs": "1.48.0",
    "@zag-js/toggle": "1.48.0",
    "@zag-js/vanilla": "1.48.0",
    "@zag-js/vue": "1.48.0",
    "culori": "4.0.2",
    "d3-array": "3.2.5",
    "d3-polygon": "3.0.2",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "fast-png": "8.0.0",
    "get-port": "7.2.0",
    "gifenc": "1.0.3",
    "happy-dom": "21.0.4",
    "harfbuzzjs": "1.6.4",
    "homebridge": "2.5.0",
    "knip": "6.45.1",
    "lightningcss": "1.33.0",
    "magic-string": "1.4.5",
    "oxc-parser": "0.159.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "picomatch": "4.0.7",
    "postcss": "8.5.33",
    "publint": "0.3.25",
    "rolldown": "1.2.19",
    "strip-json-comments": "5.0.3",
    "tailwindcss": "4.3.5",
    "toml-eslint-parser": "1.0.3",
    "typescript": "7.0.2",
    "unbash": "6.0.4",
    "vite": "8.3.8",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "yaml": "2.9.1"
  },
  "knip": {
    "entry": [
      ".mise/*/index.ts", "site/.vitepress/lib/**/*-frame.css", "site/.vitepress/lib/**/*.data.ts",
      "site/.vitepress/lib/bundle/index.ts", "src/ui/public/index.ts", "src/ui/server.ts"
    ],
    "ignoreBinaries": ["mise"],
    "ignoreDependencies": ["oxlint", "oxlint-tsgolint", "publint"],
    "project": [".mise/**/*.ts", "site/.vitepress/**/*.{css,ts,tsx}", "src/**/*.ts", "tests/**/*.ts"],
    "vitepress": { "entry": ["site/.vitepress/config.ts", "site/.vitepress/theme/index.ts"] },
    "vitest": { "config": ["site/.vitepress/vitest.config.ts", "tests/plugin/vitest.config.ts"] },
    "vue": false
  }
}
