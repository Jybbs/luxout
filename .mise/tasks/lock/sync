#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "relock"
#MISE description = "Re-resolve `.mise/mise.lock`, rerunning `mise lock` until it stops changing, install each tool the local mise config pins that mise has not installed, then re-resolve `bun.lock` and `site/bun.lock` against their manifests"

previous=$(mktemp)
trap 'rm -f "$previous"' EXIT

until cmp -s "$previous" .mise/mise.lock; do
  cp -p .mise/mise.lock "$previous"
  mise lock
done

missing=$(mise ls --json --local --missing | jq --raw-output 'keys | join(" ")')

[[ -z "$missing" ]] || mise install $missing

bun install --lockfile-only
bun install --cwd site --lockfile-only
