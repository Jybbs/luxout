#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "lockfile"
#MISE description = "Verify the `bun.lock` of each package `.mise/lib/lock.sh` lists against its manifest, and `.mise/mise.lock` against `.mise/config.toml` through `mise lock --check`, failing on a locked tool the config no longer declares"

source "$MISE_PROJECT_ROOT/.mise/lib/lock.sh"

for dir in $(bun_packages); do
  bun install --cwd "$dir" --dry-run --frozen-lockfile
done

mise lock --check

stale=$(
  mise lock --dry-run --json \
    | jq --raw-output '[.[] | select(.new_versions == []) | .name] | join(", ")'
)

if [[ -n "$stale" ]]; then
  echo ".mise/mise.lock locks $stale, which .mise/config.toml no longer declares," \
       "so run \`mise relock\`" >&2
  exit 1
fi
