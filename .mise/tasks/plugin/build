#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "build"
#MISE depends     = ["plugin:bake"]
#MISE description = "Empty `dist/`, compile `src/` into it, bundle the settings page's script under `src/ui/public/` with Zag's listbox into `dist/ui/public/index.js`, and copy the page's `index.html` and `index.css` beside it, skipping the run where every output is newer than every source"
#MISE outputs     = [
#MISE   "dist/index.js",
#MISE   "dist/ui/public/index.css",
#MISE   "dist/ui/public/index.html",
#MISE   "dist/ui/public/index.js"
#MISE ]
#MISE sources     = [
#MISE   "config.schema.json",
#MISE   "package.json",
#MISE   "src/**/*.ts",
#MISE   "src/**/tsconfig.json",
#MISE   "src/ui/public/index.css",
#MISE   "src/ui/public/index.html"
#MISE ]

rm -rf dist
tsc -p src
bun build \
  --minify \
  --outfile dist/ui/public/index.js \
  src/ui/public/index.ts
cp src/ui/public/index.{css,html} dist/ui/public/
