#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "check"
#MISE description = "Run `mise doctor project`, then `lock:check`, `repo:audit`, and the plugin's and the site's type and lint checks, then `plugin:affected` and `site:affected`, the check run before each commit"

mise doctor project
mise run \
  lock:check ::: \
  plugin:lint ::: \
  plugin:typecheck ::: \
  repo:audit ::: \
  site:lint ::: \
  site:typecheck
mise run plugin:affected
mise run site:affected
