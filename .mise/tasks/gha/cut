#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Keep one draft release for the `version` in `package.json`, creating it with generated notes where no release carries the version, replacing its notes with the ones GitHub generates against `main` where only a draft does, and failing where a published release does"

if [[ "$GITHUB_REF_NAME" != main ]]; then
  echo "A cut from $GITHUB_REF_NAME fails, since the draft's tag lands on main" >&2
  exit 1
fi

version=$(jq --raw-output .version package.json)
echo "version=$version" >>"$GITHUB_OUTPUT"

release=$(
  gh api --paginate --slurp 'repos/{owner}/{repo}/releases' \
    | jq --arg version "$version" --raw-output '
        [.[][] | select(.tag_name == $version)]
        | min_by(.draft) // empty
        | "\(if .draft then "draft" else "published" end) \(.html_url)"
      '
)

read -r state url <<<"$release"

case "$state" in
  draft)
    notes=$(
      gh api \
        --jq .body \
        --raw-field tag_name="$version" \
        --raw-field target_commitish=main \
        'repos/{owner}/{repo}/releases/generate-notes'
    )
    url=$(gh release edit --notes "$notes" "$version")
    state=refreshed
    echo "Replaced the notes of the draft release for version $version at $url"
    ;;
  published)
    echo "::error::Version $version is already published, so run \`mise bump\`" \
         "to move \`version\` in \`package.json\` to the next release"
    ;;
  *)
    url=$(
      gh release create \
        --draft \
        --generate-notes \
        --target main \
        --title "$version" \
        "$version"
    )
    state=created
    echo "Created a draft release for version $version at $url"
    ;;
esac

printf 'state=%s\nurl=%s\n' "$state" "$url" >>"$GITHUB_OUTPUT"
[[ "$state" != published ]]
