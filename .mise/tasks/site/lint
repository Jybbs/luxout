#!/usr/bin/env -S bash -euo pipefail
#MISE depends     = ["plugin:bake"]
#MISE description = "Lint the site's TypeScript and its suite under `tests/site` with type information, passing any further arguments to oxlint"
#MISE dir         = "site"

format=default
[[ -z "${GITHUB_ACTIONS:-}" ]] || format=github

oxlint --format "$format" --type-aware "$@" .vitepress
cd ../tests/site
oxlint --format "$format" --type-aware "$@" .
